apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 99-worker-nat64-route
  labels:
    machineconfiguration.openshift.io/role: worker
spec:
  config:
    ignition:
      version: 2.2.0
    storage:
      files:
        - contents:
            source: data:text/plain;charset=utf-8;base64,
            verification: {}
          filesystem: root
          mode: 493
          path: /etc/NetworkManager/dispatcher.d/90-nat64-route.sh
