{% set nat64_route_script %}
#!/bin/bash
set -eu
IFACE="$1"
STATUS="$2"
NAT64_GW="{{ static_baremetal_dns }}"
NAT64_PREFIX="64:ff9b::/96"

if [ "$IFACE" = "br-ex" ] && { [ "$STATUS" = "up" ] || [ "$STATUS" = "connectivity-change" ]; }; then
  ip -6 route replace "$NAT64_PREFIX" via "$NAT64_GW" dev br-ex
fi
{% endset %}
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 99-master-nat64-route
  labels:
    machineconfiguration.openshift.io/role: master
spec:
  config:
    ignition:
      version: 2.2.0
    storage:
      files:
        - contents:
            source: data:text/plain;charset=utf-8,{{ nat64_route_script | trim | urlencode }}
            verification: {}
          filesystem: root
          mode: 493
          path: /etc/NetworkManager/dispatcher.d/90-nat64-route.sh
